# Copy this file to .env for local development.
# In Vercel, configure these values in Project Settings > Environment Variables.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Do not set SUPABASE_PROJECT_ID or VITE_SUPABASE_PROJECT_ID unless you are
# intentionally overriding the URL. The app gives project IDs priority over URLs.

# Optional: GA4 measurement ID (for example G-XXXXXXXXXX). Google Analytics loads only after analytics consent.
VITE_GA_MEASUREMENT_ID="G-7EYPB0J019"
