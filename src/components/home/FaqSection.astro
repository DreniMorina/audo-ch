---
import { platformFaqGroups } from '@/components/faq/platform-faq';
import { faqItems } from './faq';
---

<section id="faq" class="scroll-mt-20 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">
        Häufige Fragen
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold md:text-4xl text-balance">
        Alles über Audo.ch und deinen E-Auto-Deal.
      </h2>
      <p class="mt-4 text-muted-foreground">
        Kurz beantwortet: wie Audo.ch funktioniert und worauf Käufer und Verkäufer in der
        Schweiz achten sollten.
      </p>
    </div>

    <nav aria-label="FAQ-Themen" class="mt-8 flex flex-wrap gap-2">
      {
        platformFaqGroups.map((group) => (
          <a
            href={`#${group.id}`}
            class="inline-flex h-9 items-center rounded-full border border-border bg-card px-4 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            {group.title}
          </a>
        ))
      }
      <a
        href="#ev-kauf-checkliste"
        class="inline-flex h-9 items-center rounded-full border border-border bg-card px-4 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        Checkliste für den EV-Kauf
      </a>
    </nav>

    <div class="mt-12 space-y-12">
      {
        platformFaqGroups.map((group) => (
          <section id={group.id} class="scroll-mt-24">
            <h3 class="font-display text-2xl font-semibold">{group.title}</h3>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              {group.items.map((item) => (
                <details
                  id={item.id}
                  class="group scroll-mt-24 rounded-2xl border border-border bg-card p-5 shadow-card"
                >
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display font-semibold [&::-webkit-details-marker]:hidden">
                    <span>{item.question}</span>
                    <span aria-hidden="true" class="text-xl leading-none text-muted-foreground transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        ))
      }

      <section id="ev-kauf-checkliste" class="scroll-mt-24">
        <h3 class="font-display text-2xl font-semibold">Checkliste für den EV-Kauf</h3>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-muted-foreground">
          Diese Fragen helfen bei Schweizer Privat- und Händlerverkäufen, damit Batterie,
          Reichweite, Zubehör und Administration vor der Übergabe transparent sind.
        </p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {
            faqItems.map((item, index) => (
              <details class="group rounded-2xl border border-border bg-card p-5 shadow-card">
                <summary class="flex cursor-pointer list-none items-start gap-3 font-display font-semibold [&::-webkit-details-marker]:hidden">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-electric/20 text-xs font-semibold text-graphite">
                    {index + 1}
                  </span>
                  <span class="flex-1">{item.question}</span>
                  <span aria-hidden="true" class="text-xl leading-none text-muted-foreground transition-transform group-open:rotate-45">+</span>
                </summary>
                <div class="pl-10">
                  <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.answer}</p>
                  <a
                    href={item.sourceHref}
                    target="_blank"
                    rel="noreferrer"
                    class="mt-3 inline-flex text-sm font-semibold text-foreground underline decoration-electric decoration-2 underline-offset-4 hover:text-foreground/70"
                  >
                    Quelle: {item.sourceLabel}
                  </a>
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</section>
