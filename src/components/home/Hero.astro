---
import Icon from '@/components/icons/Icon.astro';
import MarketplaceStats from '@/components/home/MarketplaceStats.astro';
import { browseHref } from '@/lib/browse-search';

const quickFilters = [
  { label: 'Tesla', href: browseHref({ brand: 'Tesla' }) },
  { label: 'VW', href: browseHref({ brand: 'VW' }) },
  { label: 'BMW', href: browseHref({ brand: 'BMW' }) },
  { label: 'Audi', href: browseHref({ brand: 'Audi' }) },
  { label: 'Unter 40 000 CHF', href: browseHref({ maxPrice: 40000 }) },
  { label: '> 500 km Reichweite', href: browseHref({ minRange: 500 }) },
];
---

<section class="relative overflow-hidden bg-gradient-hero">
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-6 pb-16 pt-16 md:grid-cols-[1.05fr_1fr] md:gap-8 md:pt-20 lg:pb-20"
  >
    <div>
      <h1
        class="mt-5 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-balance md:text-6xl lg:text-7xl"
      >
        Elektroautos kaufen und verkaufen.
      </h1>
      <h2 class="mt-5 max-w-xl text-lg font-normal text-muted-foreground">
        Der Schweizer Marktplatz für Elektroautos. Vergleiche Reichweite, Batterie, Ladeleistung und
        weitere wichtige Fahrzeugdaten – alles auf einer Plattform.
      </h2>

      {/* A plain GET form: the browser navigates to /browse?q=… without any JavaScript. */}
      <form action="/browse" method="get" class="mt-7">
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="relative flex-1">
            <Icon
              name="Search"
              class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground"
            />
            <input
              type="text"
              name="q"
              placeholder="Marke, Modell oder Ort suchen…"
              class="h-14 w-full rounded-xl border border-border bg-card pl-12 pr-4 text-base outline-none shadow-card transition-all focus:border-foreground/40 focus:ring-4 focus:ring-electric/20"
            />
          </div>
          <button
            type="submit"
            class="inline-flex h-14 items-center gap-2 rounded-xl bg-primary px-8 text-base font-semibold text-primary-foreground shadow-card transition-all hover:opacity-90"
          >
            Suchen
            <Icon name="ArrowRight" class="h-5 w-5" />
          </button>
        </div>
      </form>

      <div class="mt-4 flex flex-wrap gap-2">
        {
          quickFilters.map((filter) => (
            <a
              href={filter.href}
              class="inline-flex items-center rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium text-muted-foreground transition-all hover:border-foreground/40 hover:text-foreground"
            >
              {filter.label}
            </a>
          ))
        }
      </div>

      <MarketplaceStats server:defer>
        <div slot="fallback" class="mt-6 text-xs text-muted-foreground">
          Entdecke Elektroautos aus der ganzen Schweiz.
        </div>
      </MarketplaceStats>
    </div>

    <div class="relative" aria-hidden="true">
      <div class="relative flex aspect-[16/11] items-center justify-center overflow-hidden rounded-2xl border border-border bg-graphite shadow-elevated">
        <div class="absolute -right-16 -top-20 h-72 w-72 rounded-full bg-electric/20 blur-3xl"></div>
        <div class="absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-sky/20 blur-3xl"></div>
        <div class="relative flex h-40 w-72 items-center rounded-[2rem] border-4 border-white/80 p-4 sm:h-48 sm:w-80">
          <div class="absolute -right-5 h-16 w-5 rounded-r-lg bg-white/80"></div>
          <div class="h-full w-[82%] rounded-2xl bg-electric shadow-[0_0_45px_rgba(148,240,0,0.35)]"></div>
          <Icon name="Zap" class="absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 text-graphite" strokeWidth={2.5} />
        </div>
      </div>
      <div
        class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-border bg-card p-4 shadow-elevated sm:block"
      >
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-electric/20 text-graphite"
          >
            <Icon name="Battery" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs text-muted-foreground">Batteriezustand</p>
            <p class="font-display text-lg font-semibold">94 % SoH</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
