---
import Icon from '@/components/icons/Icon.astro';
import ListingCard from '@/components/site/ListingCard.astro';
import type { Listing } from '@/data/listings';

interface Props {
  listings: Listing[];
}

const { listings } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 class="font-display text-3xl font-semibold md:text-4xl">Neueste Inserate</h2>
    </div>
    <a
      href="/browse"
      class="hidden items-center gap-1 text-sm font-medium text-foreground hover:gap-2 transition-all md:inline-flex"
    >
      Alle anzeigen
      <Icon name="ArrowRight" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {listings.slice(0, 6).map((listing) => <ListingCard listing={listing} />)}
  </div>
</section>
