---
import Icon from '@/components/icons/Icon.astro';
import type { IconName } from '@/components/icons/icons';

const items: Array<{ icon: IconName; label: string }> = [
  { icon: 'Battery', label: 'Batteriezustand in jedem Inserat' },
  { icon: 'Gauge', label: 'Geprüfte WLTP-Reichweite' },
  { icon: 'Zap', label: 'Reale Ladegeschwindigkeiten' },
  { icon: 'BadgeCheck', label: 'Verbleibende Herstellergarantie' },
];
---

<section class="border-y border-border/60 bg-secondary/50">
  <div class="mx-auto grid max-w-7xl gap-6 px-6 py-8 md:grid-cols-4">
    {
      items.map((item) => (
        <div class="flex items-center gap-3 text-sm">
          <Icon name={item.icon} class="h-4 w-4 text-foreground/60" />
          <span class="text-muted-foreground">{item.label}</span>
        </div>
      ))
    }
  </div>
</section>
