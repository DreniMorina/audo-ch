---
import { platformFaqGroups } from './platform-faq';

/**
 * Answers stay expanded instead of sitting behind an accordion: the page exists to
 * be quoted by search and AI answer engines, and not every crawler runs JavaScript
 * or opens collapsed content. That also keeps the component script-free.
 */
---

<main class="flex-1">
  <section class="bg-gradient-hero">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">
        Häufige Fragen
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl text-balance">
        Alles über Audo.ch, den Schweizer Marktplatz für Elektroautos.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
        Wie Inserate entstehen, was sie kosten, wie du Verkäufer erreichst und wer hinter
        Audo.ch steht — kurz beantwortet.
      </p>

      <nav aria-label="Themen" class="mt-8 flex flex-wrap gap-2">
        {
          platformFaqGroups.map((group) => (
            <a
              href={`#${group.id}`}
              class="inline-flex h-9 items-center rounded-full border border-border bg-card px-4 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              {group.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="mx-auto max-w-5xl space-y-14 px-6 py-16">
    {
      platformFaqGroups.map((group) => (
        <section id={group.id} class="scroll-mt-24">
          <h2 class="font-display text-2xl font-semibold md:text-3xl">{group.title}</h2>

          <div class="mt-6 divide-y divide-border overflow-hidden rounded-3xl border border-border bg-card shadow-card">
            {group.items.map((item) => (
              <article id={item.id} class="scroll-mt-24 p-6 md:p-8">
                <h3 class="font-display text-lg font-semibold md:text-xl">{item.question}</h3>
                <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.answer}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <section class="rounded-3xl border border-border bg-secondary/60 p-8">
      <h2 class="font-display text-2xl font-semibold">Noch eine Frage offen?</h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">
        Fragen rund um den Kauf eines gebrauchten Elektroautos — Batteriezustand, Garantie,
        Reichweite im Winter oder Code 178 — beantwortet die Checkliste auf der Startseite.
        Alles andere beantworten wir per E-Mail.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/#faq"
          class="inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-all hover:opacity-90"
        >
          Checkliste für den EV-Kauf
        </a>
        <a
          href="mailto:hallo@audo.ch"
          class="inline-flex h-11 items-center rounded-md border border-border bg-card px-5 text-sm font-semibold text-foreground transition-all hover:border-foreground/40"
        >
          hallo@audo.ch
        </a>
      </div>
    </section>
  </div>
</main>
