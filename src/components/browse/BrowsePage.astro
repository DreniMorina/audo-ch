---
import Icon from '@/components/icons/Icon.astro';
import ListingCard from '@/components/site/ListingCard.astro';
import type { Listing } from '@/data/listings';
import { browseHref, type BrowseSearch } from '@/lib/browse-search';

interface Props {
  listings: Listing[];
  search: BrowseSearch;
  total: number;
  page: number;
  pageCount: number;
}

const { listings, search, total, page, pageCount } = Astro.props;
const query = search.q ?? '';
const brand = search.brand ?? 'Alle';
const maxPrice = search.maxPrice ?? 150000;
const minRange = search.minRange ?? 0;
const seller = search.seller ?? 'Alle';
const brands = Array.from(new Set([...listings.map((listing) => listing.brand), ...(brand !== 'Alle' ? [brand] : [])])).sort();
const pages = Array.from({ length: pageCount }, (_, index) => index + 1).filter(
  (number) => number === 1 || number === pageCount || Math.abs(number - page) <= 2,
);
---

<main class="mx-auto w-full max-w-7xl flex-1 px-6 py-10">
  <form action="/browse" method="get">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="font-display text-3xl font-semibold md:text-4xl">Elektroautos kaufen</h1>
        <p class="mt-2 text-muted-foreground">{total} Fahrzeuge passen zu deinen Filtern</p>
      </div>
      <div class="relative w-full md:w-auto">
        <Icon name="Search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        <input name="q" value={query} placeholder="Marke, Modell, Ort suchen…" class="h-11 w-full rounded-md border border-border bg-card pl-9 pr-4 text-sm outline-none focus:border-foreground/40 focus:ring-4 focus:ring-electric/20 md:w-80" />
      </div>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[260px_1fr]">
      <aside class="space-y-6 rounded-2xl border border-border/70 bg-card p-5 shadow-card h-fit lg:sticky lg:top-20">
        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-widest text-muted-foreground">Marke</span>
          <select name="brand" class="h-10 w-full rounded-md border border-border bg-background px-3 text-sm outline-none focus:border-foreground/40">
            <option value="Alle" selected={brand === 'Alle'}>Alle</option>
            {brands.map((item) => <option value={item} selected={brand === item}>{item}</option>)}
          </select>
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-widest text-muted-foreground">Max. Preis · CHF {maxPrice.toLocaleString('de-CH')}</span>
          <input name="maxPrice" type="range" min="10000" max="150000" step="1000" value={maxPrice} class="w-full accent-graphite" />
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-widest text-muted-foreground">Min. Reichweite · {minRange} km</span>
          <input name="minRange" type="range" min="0" max="600" step="10" value={minRange} class="w-full accent-graphite" />
        </label>

        <fieldset>
          <legend class="mb-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">Verkäufertyp</legend>
          <div class="grid grid-cols-3 gap-1 rounded-md bg-secondary p-1 text-xs">
            {(['Alle', 'Private', 'Dealer'] as const).map((value) => (
              <label class:list={['cursor-pointer rounded px-1 py-2 text-center', seller === value ? 'bg-card font-medium shadow-card' : 'text-muted-foreground']}>
                <input class="sr-only" type="radio" name="seller" value={value} checked={seller === value} />
                {value === 'Private' ? 'Privat' : value === 'Dealer' ? 'Händler' : 'Alle'}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="flex cursor-pointer items-center gap-3 text-sm">
          <input name="fastOnly" value="1" type="checkbox" checked={search.fastOnly} class="h-4 w-4 accent-graphite" />
          <span>Nur Schnellladen</span>
        </label>
        <label class="flex cursor-pointer items-center gap-3 text-sm">
          <input name="certificateOnly" value="1" type="checkbox" checked={search.certificateOnly} class="h-4 w-4 accent-graphite" />
          <span>Nur mit Batteriezertifikat</span>
        </label>
        <button type="submit" class="h-10 w-full rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground">Filter anwenden</button>
        <a href="/browse" class="block text-center text-xs text-muted-foreground hover:text-foreground">Filter zurücksetzen</a>
      </aside>

      <div>
        {listings.length === 0 ? (
          <div class="rounded-2xl border border-dashed border-border p-12 text-center text-muted-foreground">Keine Fahrzeuge passen zu diesen Filtern. Erweitere deine Suche.</div>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {listings.map((listing) => <ListingCard listing={listing} />)}
          </div>
        )}
      </div>
    </div>
  </form>

  {pageCount > 1 && (
    <nav aria-label="Seitennavigation" class="mt-10 flex flex-wrap justify-center gap-2">
      {page > 1 && <a href={browseHref({ ...search, page: page - 1 })} class="rounded-md border border-border px-3 py-2 text-sm">Zurück</a>}
      {pages.map((number, index) => (
        <>
          {index > 0 && pages[index - 1] !== number - 1 && <span class="px-1 py-2">…</span>}
          <a href={browseHref({ ...search, page: number })} aria-current={number === page ? 'page' : undefined} class:list={['rounded-md border px-3 py-2 text-sm', number === page ? 'border-primary bg-primary text-primary-foreground' : 'border-border']}>{number}</a>
        </>
      ))}
      {page < pageCount && <a href={browseHref({ ...search, page: page + 1 })} class="rounded-md border border-border px-3 py-2 text-sm">Weiter</a>}
    </nav>
  )}
</main>
