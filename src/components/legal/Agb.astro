          {prohibitedListings.map((prohibitedListing) => (
            <li>{prohibitedListing}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-display text-lg font-semibold">
          5. Veröffentlichung von Inseraten
        </h2>
