---
const platformFeatures = [
  "das Veröffentlichen von Inseraten für Elektrofahrzeuge,",
  "das Suchen und Vergleichen von Fahrzeugen,",
  "die Kontaktaufnahme zwischen Käufern und Verkäufern.",
];

const userRegistrationObligations = [
  "wahrheitsgemässe Angaben zu machen,",
  "seine Zugangsdaten sorgfältig aufzubewahren,",
  "keine fremden Benutzerkonten zu verwenden,",
  "Änderungen seiner Angaben aktuell zu halten.",
];

const listingConfirmations = [
  "dass er berechtigt ist, das Fahrzeug anzubieten,",
  "dass sämtliche Angaben nach bestem Wissen richtig und vollständig sind,",
  "dass hochgeladene Bilder das angebotene Fahrzeug zeigen,",
  "dass keine Rechte Dritter verletzt werden.",
];

const prohibitedListings = [
  "falsche oder irreführende Angaben,",
  "manipulierte Fahrzeugdaten,",
  "Fake-Inserate,",
  "Fahrzeuge, die keine vollelektrischen Fahrzeuge sind,",
  "rechtswidrige Inhalte,",
  "beleidigende Inhalte,",
  "Werbung für andere Plattformen,",
  "automatisierte Inserate ohne Zustimmung der Betreiberin.",
];

const moderationActions = [
  "Inserate zu bearbeiten,",
  "Inserate auszublenden,",
  "Inserate zu sperren,",
  "Inserate zu löschen,",
  "Benutzerkonten einzuschränken oder zu sperren,",
];

const excludedResponsibilities = [
  "den Vertragsabschluss,",
  "den Fahrzeugzustand,",
  "den Batteriezustand,",
  "Garantien,",
  "Fahrzeughistorien,",
  "Kilometerstände,",
  "Reichweitenangaben,",
  "Ladeleistungen,",
  "Kaufpreise,",
  "Zahlungen,",
  "Fahrzeugübergaben,",
  "Gewährleistungsansprüche.",
];

const userObligations = [
  "ausschliesslich rechtmässige Inhalte zu veröffentlichen,",
  "keine Rechte Dritter zu verletzen,",
  "die Plattform nicht missbräuchlich zu verwenden,",
  "keine Schadsoftware zu verbreiten,",
  "keine Bots oder automatisierte Systeme einzusetzen,",
  "keine technischen Schutzmassnahmen zu umgehen.",
];

const warrantyExclusions = [
  "Richtigkeit,",
  "Vollständigkeit,",
  "Aktualität,",
  "Verfügbarkeit,",
  "Fehlerfreiheit oder",
  "Qualität",
];

const liabilityExclusions = [
  "falsche Inserate,",
  "fehlerhafte Fahrzeugangaben,",
  "Betrug durch Dritte,",
  "entgangene Geschäfte,",
  "Datenverlust,",
  "technische Ausfälle,",
  "Unterbrüche der Plattform,",
  "indirekte Schäden oder Folgeschäden.",
];

const platformChanges = [
  "Funktionen zu ändern,",
  "Funktionen einzustellen,",
  "neue Funktionen einzuführen,",
  "Inhalte anzupassen,",
  "die Plattform jederzeit weiterzuentwickeln.",
];
