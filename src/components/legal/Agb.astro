<main class="flex-1">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="font-display text-4xl font-semibold">Allgemeine Geschäftsbedingungen</h1>
    <p class="mt-4 text-sm text-muted-foreground">Stand: 28. Juni 2026</p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-foreground">
      <section>
        <h2 class="font-display text-lg font-semibold">1. Geltungsbereich</h2>
        <p class="mt-2 text-muted-foreground">
          Diese Allgemeinen Geschäftsbedingungen (AGB) regeln die Nutzung der Online-Plattform{" "}
          <strong>Audo.ch</strong>.
        </p>
        <div class="mt-4 space-y-1 text-muted-foreground">
          <p>Audo.ch wird betrieben von:</p>
          <p>
            <strong>yulci GmbH</strong>
            <br />
            Neuhausen am Rheinfall
            <br />
            Schweiz
          </p>
          <p>
            Handelsregister-Nr.: <strong>CHE-223.944.232</strong>
          </p>
          <p>
            Vertretungsberechtigte Person: <strong>Dreni Morina</strong>
          </p>
          <p>
