---
import Icon from '@/components/icons/Icon.astro';
import type { IconName } from '@/components/icons/icons';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: string;
  primaryTo: '/browse' | '/elektroauto-verkaufen-schweiz';
  secondaryCta: string;
  secondaryTo: '/browse' | '/elektroauto-verkaufen-schweiz';
  sections: Array<{ title: string; body: string }>;
}

const { eyebrow, title, description, primaryCta, primaryTo, secondaryCta, secondaryTo, sections } =
  Astro.props;

const icons: IconName[] = ['Search', 'Battery', 'Zap', 'BadgeCheck'];
---

<main class="flex-1">
  <section class="bg-gradient-hero">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">{eyebrow}</p>
      <h1
        class="mt-4 max-w-4xl font-display text-4xl font-semibold leading-tight tracking-tight md:text-6xl"
      >
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">{description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={primaryTo}
          class="inline-flex h-12 items-center gap-2 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-all hover:opacity-90"
        >
          {primaryCta}
          <Icon name="ArrowRight" class="h-4 w-4" />
        </a>
        <a
          href={secondaryTo}
          class="inline-flex h-12 items-center rounded-md border border-border bg-card px-5 text-sm font-semibold text-foreground transition-all hover:border-foreground/40"
        >
          {secondaryCta}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-5 px-6 py-16 md:grid-cols-2">
    {
      sections.map((section, index) => (
        <article class="rounded-3xl border border-border bg-card p-6 shadow-card">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-electric/20 text-graphite">
            <Icon name={icons[index % icons.length]} class="h-5 w-5" />
          </span>
          <h2 class="mt-5 font-display text-2xl font-semibold">{section.title}</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{section.body}</p>
        </article>
      ))
    }
  </section>
</main>
