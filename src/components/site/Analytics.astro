{/* Swiss-market opt-out: analytics runs by default until the visitor objects. */}
<script>
  import { onConsentChange, readConsent } from '@/lib/cookie-consent';
  import {
    disableGoogleAnalytics,
    enableGoogleAnalytics,
    initializeGoogleAnalytics,
    trackPageView,
  } from '@/lib/google-analytics';

  let initialized = false;
  let analyticsAllowed = false;
  let idleCallback: number | undefined;

  function cancelScheduledInitialization() {
    if (idleCallback === undefined) return;

    if ('cancelIdleCallback' in window) {
      window.cancelIdleCallback(idleCallback);
    } else {
      globalThis.clearTimeout(idleCallback);
    }
    idleCallback = undefined;
  }

  function initialize() {
    idleCallback = undefined;
    if (!analyticsAllowed || initialized) return;

    initializeGoogleAnalytics();
    initialized = true;

    // Astro serves a multi-page app, so each navigation is a document load and the
    // page view is sent once per page rather than on router location changes.
    trackPageView(window.location.href);
  }

  function scheduleInitialization() {
    if (initialized || idleCallback !== undefined) return;

    const scheduleWhenIdle = () => {
      if (!analyticsAllowed || initialized || idleCallback !== undefined) return;

      idleCallback = 'requestIdleCallback' in window
        ? window.requestIdleCallback(initialize, { timeout: 2500 })
        : (globalThis.setTimeout(initialize, 1) as unknown as number);
    };

    if (document.readyState === 'complete') {
      scheduleWhenIdle();
    } else {
      window.addEventListener('load', scheduleWhenIdle, { once: true });
    }
  }

  function applyConsent(isAllowed: boolean) {
    const wasAllowed = analyticsAllowed;
    analyticsAllowed = isAllowed;

    if (!isAllowed) {
      cancelScheduledInitialization();
      disableGoogleAnalytics();
      return;
    }

    if (initialized) {
      enableGoogleAnalytics();
      if (!wasAllowed) trackPageView(window.location.href);
    } else {
      scheduleInitialization();
    }
  }

  applyConsent(readConsent()?.analytics ?? true);
  onConsentChange((consent) => applyConsent(consent.analytics));
</script>
