---
const LINKS = [
  { href: '/browse', label: 'Entdecken' },
  { href: '/#why', label: 'Warum nur EVs' },
  { href: 'mailto:hallo@audo.ch', label: 'Kontakt' },
  { href: '/impressum', label: 'Impressum' },
  { href: '/datenschutz', label: 'Datenschutz' },
  { href: '/elektroauto-kaufen-schweiz', label: 'Elektroauto kaufen' },
  { href: '/gebrauchte-elektroautos-schweiz', label: 'E-Auto Occasion' },
  { href: '/agb', label: 'AGB' },
];
---

<footer class="border-t border-border/60 bg-secondary/40">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="flex items-center gap-2">
        <span class="font-display text-[1.35rem] font-extrabold text-primary">Audo.ch</span>
        <span class="ml-2 text-sm text-muted-foreground">EV-Marktplatz · Schweiz</span>
      </div>
      <nav class="flex flex-wrap gap-6 text-sm text-muted-foreground">
        {LINKS.map((link) => <a href={link.href} class="hover:text-foreground">{link.label}</a>)}
      </nav>
    </div>
    <p class="mt-8 text-xs text-muted-foreground">
      © {new Date().getFullYear()} audo.ch — Der Schweizer Marktplatz für Elektroautos:
      Reichweite, Batterie und Vertrauen.
    </p>
  </div>
</footer>
