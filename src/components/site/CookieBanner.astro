---
import Icon from '@/components/icons/Icon.astro';

const DEFAULT_GA_MEASUREMENT_ID = 'G-7EYPB0J019';
const measurementId =
  (import.meta.env.VITE_GA_MEASUREMENT_ID as string | undefined)?.trim() ||
  DEFAULT_GA_MEASUREMENT_ID;
---

{/* Hidden until the script confirms no decision is stored yet. */}
<div
  hidden
  data-cookie-banner
  data-ga-measurement-id={measurementId}
  role="dialog"
  aria-modal="false"
  aria-label="Cookie-Einstellungen"
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-border bg-card/95 pb-[env(safe-area-inset-bottom)] shadow-2xl backdrop-blur-sm"
>
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 md:py-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-start gap-3 md:max-w-2xl">
        <span
          class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-electric/15 text-graphite"
        >
          <Icon name="BarChart3" class="h-4 w-4" />
        </span>
        <div>
          <p class="text-sm font-medium text-foreground">Cookie-Einstellungen</p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
            Audo.ch verwendet Google Analytics standardmässig für unpersonalisierte
            Nutzungsstatistiken. Du kannst der Statistik-Nutzung widersprechen und deine
            Entscheidung jederzeit über den Footer ändern.{' '}
            <a href="/datenschutz" class="underline underline-offset-2 hover:text-foreground">
              Datenschutzerklärung
            </a>
          </p>
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2 md:justify-end">
        <button
          type="button"
          data-consent="deny"
          class="inline-flex h-10 items-center rounded-lg border border-border bg-card px-5 text-sm font-semibold text-foreground transition-colors hover:bg-secondary"
        >
          Statistik deaktivieren
        </button>
        <button
          type="button"
          data-consent="allow"
          class="inline-flex h-10 items-center rounded-lg bg-primary px-6 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Einverstanden
        </button>
      </div>
    </div>
  </div>
</div>

<!--
  Keep this small bootstrap inline: the banner and deferred analytics do not need a
  render-blocking module request (or a second request for a shared consent module).
-->
<script is:inline>
  const STORAGE_KEY = 'audo_cookie_consent';
  const GA_SCRIPT_ID = 'google-analytics-gtag';
  const banner = document.querySelector('[data-cookie-banner]');

  if (banner) {
    const measurementId = banner.dataset.gaMeasurementId;
    let initialized = false;
    let analyticsAllowed = false;
    let idleCallback;

    function readConsent() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        return JSON.parse(raw).analytics === true;
      } catch {
        return null;
      }
    }

    function setConsent(isAllowed) {
      try {
        window.localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ necessary: true, analytics: isAllowed }),
        );
      } catch {
        // Keep applying the in-memory choice when storage is unavailable.
      }
      applyConsent(isAllowed);
    }

    function updateGoogleConsent(isAllowed) {
      if (!window.gtag) return;
      window.gtag('consent', 'update', {
        analytics_storage: isAllowed ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    }

    function initializeAnalytics() {
      idleCallback = undefined;
      if (!analyticsAllowed || initialized || !measurementId) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      window.gtag('set', {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
        ads_data_redaction: true,
      });

      if (!document.getElementById(GA_SCRIPT_ID)) {
        const script = document.createElement('script');
        script.id = GA_SCRIPT_ID;
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);
      }

      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        send_page_view: false,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      updateGoogleConsent(true);
      window.gtag('event', 'page_view', {
        page_path: `${window.location.pathname}${window.location.search}${window.location.hash}`,
        page_location: window.location.href,
        page_title: document.title || undefined,
        send_to: measurementId,
      });
      initialized = true;
    }

    function scheduleAnalytics() {
      if (initialized || idleCallback !== undefined) return;

      const scheduleWhenIdle = () => {
        if (!analyticsAllowed || initialized || idleCallback !== undefined) return;
        idleCallback = 'requestIdleCallback' in window
          ? window.requestIdleCallback(initializeAnalytics, { timeout: 2500 })
          : window.setTimeout(initializeAnalytics, 1);
      };

      if (document.readyState === 'complete') scheduleWhenIdle();
      else window.addEventListener('load', scheduleWhenIdle, { once: true });
    }

    function applyConsent(isAllowed) {
      const wasAllowed = analyticsAllowed;
      analyticsAllowed = isAllowed;

      if (!isAllowed) {
        if (idleCallback !== undefined) {
          if ('cancelIdleCallback' in window) window.cancelIdleCallback(idleCallback);
          else window.clearTimeout(idleCallback);
          idleCallback = undefined;
        }
        updateGoogleConsent(false);
        return;
      }

      if (initialized) {
        updateGoogleConsent(true);
        if (!wasAllowed) {
          window.gtag('event', 'page_view', {
            page_path: `${window.location.pathname}${window.location.search}${window.location.hash}`,
            page_location: window.location.href,
            page_title: document.title || undefined,
            send_to: measurementId,
          });
        }
      } else {
        scheduleAnalytics();
      }
    }

    const storedConsent = readConsent();
    banner.hidden = storedConsent !== null;
    applyConsent(storedConsent ?? true);

    document.addEventListener('audo:open-cookie-settings', () => {
      banner.hidden = false;
    });

    banner.querySelectorAll('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        setConsent(button.dataset.consent === 'allow');
        banner.hidden = true;
      });
    });

    window.addEventListener('storage', (event) => {
      if (event.key !== STORAGE_KEY) return;
      const consent = readConsent();
      banner.hidden = consent !== null;
      applyConsent(consent ?? true);
    });
  }
</script>
