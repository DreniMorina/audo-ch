---
import Icon from '@/components/icons/Icon.astro';
import type { Listing } from '@/data/listings';
import { formatEUR, formatKm } from '@/lib/format';

interface Props {
  listing: Listing;
  /** The first above-the-fold result is a likely LCP candidate. */
  priority?: boolean;
}

const { listing, priority = false } = Astro.props;

const specs = [
  { icon: 'Battery', label: `${listing.batteryKwh} kWh` },
  { icon: 'Gauge', label: `${listing.rangeKm} km` },
  { icon: 'MapPin', label: listing.location },
] as const;
---

<a
  href={`/listings/${listing.id}`}
  class="group block overflow-hidden rounded-2xl border border-border/70 bg-card shadow-card transition-all hover:-translate-y-0.5 hover:shadow-elevated"
  data-listing
  data-brand={listing.brand}
  data-price={listing.price}
  data-range={listing.rangeKm}
  data-seller-type={listing.sellerType}
  data-fast-charging={String(listing.fastCharging)}
  data-certificate={String(Boolean(listing.batteryCertificatePdfUrl))}
  data-haystack={`${listing.brand} ${listing.model} ${listing.location}`.toLowerCase()}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-silver-light">
    <img
      src={listing.image}
      alt={`${listing.brand} ${listing.model}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="1200"
      height="800"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute left-3 top-3 flex gap-1.5">
      <span
        class="rounded-full bg-background/90 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur"
        >{listing.sellerType === 'Dealer' ? 'Händler' : 'Privat'}</span
      >
      {
        listing.fastCharging && (
          <span class="inline-flex items-center gap-1 rounded-full bg-graphite px-2.5 py-1 text-[11px] font-medium text-electric">
            <Icon name="Zap" class="h-3 w-3" strokeWidth={2.5} />
            {listing.chargingKw} kW
          </span>
        )
      }
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-baseline justify-between gap-3">
      <div>
        <h3 class="font-display text-base font-semibold leading-tight">
          {listing.brand} {listing.model}
        </h3>
        <p class="mt-0.5 text-xs text-muted-foreground">
          {listing.year} · {formatKm(listing.mileage)}
        </p>
      </div>
      <div class="text-right">
        <p class="font-display text-lg font-semibold">{formatEUR(listing.price)}</p>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-2 border-t border-border/60 pt-4 text-xs">
      {
        specs.map((spec) => (
          <div class="flex items-center gap-1.5 text-muted-foreground">
            <span class="text-foreground/70">
              <Icon name={spec.icon} class="h-3.5 w-3.5" />
            </span>
            <span class="truncate">{spec.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</a>
