---
import Icon from '@/components/icons/Icon.astro';
import SpecBox from './SpecBox.astro';
import { sellerLabel } from './seller-label';
import type { Listing } from '@/data/listings';
import { formatKm } from '@/lib/format';
import type { IconName } from '@/components/icons/icons';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;

const specs: Array<{ icon: IconName; label: string; value: string }> = [
  { icon: 'Battery', label: 'Batterie', value: `${listing.batteryKwh} kWh` },
  { icon: 'Gauge', label: 'WLTP-Reichweite', value: `${listing.rangeKm} km` },
  { icon: 'Zap', label: 'DC-Spitze', value: `${listing.chargingKw} kW` },
  { icon: 'Calendar', label: 'Baujahr', value: String(listing.year) },
  { icon: 'MapPin', label: 'Standort', value: `${listing.location}, ${listing.country}` },
  {
    icon: 'ShieldCheck',
    label: 'Restgarantie',
    value: listing.warrantyMonths ? `${listing.warrantyMonths} Monate` : '—',
  },
];

const hasBatterySection =
  listing.batteryHealth ||
  listing.batteryCertificateDate ||
  listing.batteryCertificateProvider ||
  listing.batteryCertificatePdfUrl;
---

<div class="mt-8">
  <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
    {sellerLabel(listing.sellerType)} · {listing.location}, {listing.country}
  </p>
  <h1 class="mt-2 font-display text-4xl font-semibold leading-tight">
    {listing.brand} {listing.model}
  </h1>
  <p class="mt-2 text-lg text-muted-foreground">
    {listing.year} · {formatKm(listing.mileage)}
  </p>
</div>

{
  listing.description ? (
    <section class="mt-8 max-w-2xl rounded-2xl border border-border bg-card/60 p-5 shadow-sm">
      <h2 class="font-display text-lg font-semibold text-foreground">Beschreibung</h2>
      <p class="mt-3 whitespace-pre-line text-base leading-8 text-foreground/90">
        {listing.description}
      </p>
    </section>
  ) : null
}

<div class="mt-10">
  <h2 class="font-display text-xl font-semibold">EV-Specs</h2>
  <dl class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3">
    {specs.map((spec) => <SpecBox icon={spec.icon} label={spec.label} value={spec.value} />)}
  </dl>
</div>

{
  hasBatterySection && (
    <div class="mt-10 rounded-3xl border border-border bg-card p-6 shadow-card">
      <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
        <Icon name="BadgeCheck" class="h-4 w-4 text-foreground" />
        Batteriestatus
      </div>
      <dl class="mt-4 space-y-2 text-sm">
        {listing.batteryHealth && (
          <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Batteriezustand (SoH)</dt>
            <dd class="font-medium text-foreground">{listing.batteryHealth} %</dd>
          </div>
        )}
        {listing.batteryCertificateDate && (
          <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Datum des Zertifikats</dt>
            <dd class="font-medium text-foreground">{listing.batteryCertificateDate}</dd>
          </div>
        )}
        {listing.batteryCertificateProvider && (
          <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Prüfanbieter</dt>
            <dd class="font-medium text-foreground">{listing.batteryCertificateProvider}</dd>
          </div>
        )}
      </dl>
      {listing.batteryCertificatePdfUrl && (
        <a
          href={listing.batteryCertificatePdfUrl}
          target="_blank"
          rel="noreferrer"
          class="mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-md border border-border bg-card px-4 text-sm font-medium text-foreground transition-all hover:border-foreground/40"
        >
          <Icon name="FileText" class="h-4 w-4" /> Offizielles Batteriezertifikat öffnen (PDF)
        </a>
      )}
      <p class="mt-4 text-xs text-muted-foreground">
        Hinweis: audo.ch übernimmt keine Gewähr für die Richtigkeit oder Aktualität der Angaben und
        Zertifikate. Käuferinnen und Käufer müssen den aktuellen Batteriestatus vor dem Kauf selbst
        verifizieren.
      </p>
    </div>
  )
}
