---
import Icon from '@/components/icons/Icon.astro';
import { sellerLabel } from './seller-label';
import type { Listing } from '@/data/listings';
import { formatCHF } from '@/lib/format';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
---

<aside class="lg:sticky lg:top-20 h-fit space-y-4">
  <div class="rounded-3xl border border-border bg-card p-6 shadow-elevated">
    <p class="text-xs uppercase tracking-widest text-muted-foreground">Preis</p>
    <p class="mt-1 font-display text-4xl font-semibold">{formatCHF(listing.price)}</p>
    <p class="mt-1 text-xs text-muted-foreground">inkl. MwSt., sofern anwendbar</p>

    <div class="mt-6 space-y-2">
      {
        listing.sellerEmail && (
          <a
            href={`mailto:${listing.sellerEmail}`}
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-md bg-primary text-sm font-medium text-primary-foreground transition-all hover:opacity-90"
          >
            <Icon name="Mail" class="h-4 w-4" /> E-Mail öffnen
          </a>
        )
      }
      {
        listing.sellerPhone && (
          <button
            type="button"
            data-reveal-phone
            data-phone={listing.sellerPhone}
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-md border border-border bg-card text-sm font-medium text-foreground transition-all hover:border-foreground/40"
          >
            <Icon name="Phone" class="h-4 w-4" /> <span data-phone-label>Kontaktieren</span>
          </button>
        )
      }
    </div>

    <div class="mt-6 border-t border-border pt-4 text-sm text-muted-foreground">
      <p>
        Verkäufer: <span class="text-foreground">{listing.sellerName}</span>
      </p>
      <p class="mt-1">
        Typ: <span class="text-foreground">{sellerLabel(listing.sellerType)}</span>
      </p>
    </div>
  </div>

  <div class="rounded-3xl border border-border bg-secondary/60 p-6 text-sm text-muted-foreground">
    <p class="font-medium text-foreground">audo.ch-Vertrauen</p>
    <p class="mt-2">
      Batterie-, Reichweiten- und Ladedaten helfen bei der Einschätzung. Angaben zum Batteriestatus
      oder ein Zertifikat sind freiwillig und müssen vom Käufer aktuell verifiziert werden.
    </p>
  </div>
</aside>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-reveal-phone]');
  button?.addEventListener('click', () => {
    const label = button.querySelector<HTMLElement>('[data-phone-label]');
    if (label) label.textContent = button.dataset.phone ?? '';
  });
</script>
