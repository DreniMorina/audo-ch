---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className, strokeWidth = 2 } = Astro.props;
const { slug, body } = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide lucide-${slug}${className ? ` ${className}` : ''}`}
  aria-hidden="true"
  set:html={body}
/>
