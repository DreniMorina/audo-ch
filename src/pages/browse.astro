---
import Layout from '@/layouts/Layout.astro';
import BrowsePage from '@/components/browse/BrowsePage.astro';
import { parseBrowseSearch } from '@/lib/browse-search';
import { searchApprovedListings, type BrowseListingsResult } from '@/data/listings';

// Rendered per request: the listings are in the HTML and the filters this page opens
// with come from the query string.
export const prerender = false;

const search = parseBrowseSearch(Astro.url.searchParams);

let result: BrowseListingsResult = { listings: [], total: 0, page: search.page ?? 1, pageCount: 0 };
try {
  result = await searchApprovedListings(search);
} catch (error) {
  console.error('[browse] Failed to load listings', error);
}
---

<Layout
  title="Gebrauchte Elektroautos kaufen in der Schweiz — audo.ch"
  description="Suche gebrauchte Elektroautos in der Schweiz und filtere nach Marke, Preis, Reichweite, Batterie und Ladeleistung."
  path="/browse"
>
  <BrowsePage {...result} search={search} />
</Layout>
