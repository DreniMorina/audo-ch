---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Elektroauto kaufen & verkaufen Schweiz | Audo.ch"
  description="Der Schweizer Marktplatz für Elektroautos. Finde gebrauchte und neue E-Autos oder verkaufe dein Elektroauto einfach online."
  chrome={false}
>
  <div class="flex min-h-screen items-center justify-center bg-background px-4">
    <div class="max-w-md text-center">
      <h1 class="text-7xl font-bold text-foreground">404</h1>
      <h2 class="mt-4 text-xl font-semibold text-foreground">Seite nicht gefunden</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Die gesuchte Seite existiert nicht oder wurde verschoben.
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Zur Startseite
        </a>
      </div>
    </div>
  </div>
</Layout>
