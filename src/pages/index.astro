---
import Layout from '@/layouts/Layout.astro';
import { Hero } from '@/components/home/Hero';
import { TrustStrip } from '@/components/home/TrustStrip';
import { Featured } from '@/components/home/Featured';
import { WhyEvOnly } from '@/components/home/WhyEvOnly';
import { BatteryTrust } from '@/components/home/BatteryTrust';
import { FaqSection } from '@/components/home/FaqSection';
import { SellCTA } from '@/components/home/SellCTA';
import { faqJsonLd } from '@/components/home/faq';
---

<Layout
  title="Elektroauto kaufen & verkaufen Schweiz | Audo.ch"
  description="Der Schweizer Marktplatz für Elektroautos. Finde gebrauchte und neue E-Autos oder verkaufe dein Elektroauto einfach online."
  path="/"
  jsonLd={[faqJsonLd()]}
>
  <main>
    <Hero client:load />
    <TrustStrip />
    <Featured client:load />
    <WhyEvOnly />
    <BatteryTrust />
    <FaqSection />
    <SellCTA />
  </main>
</Layout>
